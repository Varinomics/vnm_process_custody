@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(vnm_process_custody CONFIG REQUIRED)
find_dependency(vnm_terminal_surface CONFIG REQUIRED)
find_dependency(Threads REQUIRED)
if(CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin)$")
    find_dependency(Qt6 6.12 COMPONENTS Core)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/vnm_terminal_process_custody_contract.cmake")
vnm_terminal_require_process_custody()
include("${CMAKE_CURRENT_LIST_DIR}/vnm_process_custody_terminal_owner_targets.cmake")
check_required_components(vnm_process_custody_terminal_owner)
